# Скопируйте в .env и заполните своими значениями.
# Обязательные для запуска (используются в application.properties).
DB_URL=jdbc:postgresql://localhost:5432/oltati
DB_USER=oltati_user
DB_PASSWORD=change_me

# dev — подробные логи и SQL, prod — только INFO.
SPRING_PROFILES_ACTIVE=dev

# Куда складывать загруженные изображения и какой префикс URL отдавать в API.
APP_STORAGE_LOCATION=./uploads
APP_STORAGE_BASE_URL=/files

# Максимум файлов в одном запросе /api/images/batch.
APP_UPLOAD_MAX_BATCH_SIZE=20

# Origin(ы) фронтенда для CORS, через запятую.
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
